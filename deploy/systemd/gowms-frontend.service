# /etc/systemd/system/gowms-frontend.service
#
# Menjalankan build produksi Next.js (`next start`) sebagai service biasa —
# tanpa Docker, sama seperti pola gowms-backend.service di repo backend.
# Next.js tetap butuh proses Node hidup (bukan file statis murni) karena
# sebagian halaman pakai Server Components / API routes.

[Unit]
Description=StokRSD WMS Frontend (Next.js)
After=network.target gowms-backend.service
Wants=gowms-backend.service

[Service]
Type=simple
User=gowms
Group=gowms
WorkingDirectory=/opt/gowms/frontend
EnvironmentFile=/opt/gowms/frontend/.env.production.local
# Next.js production server dari `next start`; PORT diset lewat env agar
# tidak bentrok dengan backend (8080) atau layanan lain di VPS yang sama.
Environment=PORT=3000
ExecStart=/usr/bin/npx next start -p 3000
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Hardening dasar (sama seperti backend)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=append:/var/log/gowms/frontend.log
StandardError=append:/var/log/gowms/frontend.error.log

[Install]
WantedBy=multi-user.target
